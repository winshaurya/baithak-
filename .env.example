# Copy to .env.local and fill in.
#
# Server fallback keys:
# Google Gemini provides both audio transcription (with speaker diarization) and structured analysis.
# Supports multiple comma-separated keys for automatic failover when quota / rate limits are hit:
# e.g. GOOGLE_GENERATIVE_AI_API_KEY=key1,key2,key3
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (optional alternative Whisper provider). Supports comma-separated keys. Free key: https://console.groq.com/keys
GROQ_API_KEY=
